rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public leaderboard, but scores can only be created or improved
    // by the anonymous Firebase user who owns that document ID.
    match /scores/{userId} {
      allow get, list: if true;

      function validScore() {
        return request.resource.data.keys().hasAll([
            'uid', 'nickname', 'score', 'wave', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'nickname', 'score', 'wave', 'createdAt'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.nickname is string
          && request.resource.data.nickname.matches('^[A-Za-z0-9_-]{2,16}$')
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100000000
          && request.resource.data.wave is int
          && request.resource.data.wave >= 1
          && request.resource.data.wave <= 10000
          // Firestore serverTimestamp() resolves to request.time.
          && request.resource.data.createdAt == request.time;
      }

      allow create: if request.auth != null
        && request.auth.uid == userId
        && validScore();

      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.uid == userId
        && request.resource.data.score > resource.data.score
        && validScore();

      // Only project admins may remove entries using the Firebase Console
      // or a trusted server/admin SDK; regular web users cannot delete.
      allow delete: if false;
    }
  }
}
